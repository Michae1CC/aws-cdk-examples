global:
  scrape_interval: 15s
  scrape_timeout: 10s

scrape_configs:
  - job_name: "${AUTO_SCALING_GROUP_NAME}-${INSTANCE_ID}"
    metrics_path: /metrics
    static_configs:
      # nginx-prometheus-exporter listens of port 9113 by default: https://github.com/nginx/nginx-prometheus-exporter/blob/main/README.md
      - targets: ["127.0.0.1:9113"]
        labels:
          InstanceId: "${INSTANCE_ID}"
          InstanceType: "${INSTANCE_TYPE}"
          AutoScalingGroupName: "${AUTO_SCALING_GROUP_NAME}"
    metric_relabel_configs:
      - source_labels: ["__name__"]
        regex: "nginx_up|nginx_http_requests_total|nginx_connections_.*"
        action: keep
